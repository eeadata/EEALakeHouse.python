# Copy to .env (gitignored) and fill in. docker compose reads it automatically.

# --- where the sibling repos live, relative to this project or absolute ------
EEALAKEHOUSE_DIR=
SDI_METADATA_DIR=

# --- the services -----------------------------------------------------------
# Defaults target the eea-lakehouse stack by container name, which only resolves
# once this container joins that network (see docker-compose.yml). Against a
# real deployment, put the real hosts here instead.
DDS_BASE_URL=
DREMIO_BASE_URL=

# --- credentials — never commit -------------------------------------------
# DREMIO_TOKEN is a Personal Access Token (Dremio → Account Settings → Personal
# Access Tokens). In the local stack's stub auth mode the token is simply the
# username: alice (read-write), bob (read-only), carol (no access).
DREMIO_USER=
DREMIO_TOKEN=

# --- notebooks --------------------------------------------------------------
JUPYTER_HOST_PORT=
# Leave empty for a token-free lab on localhost; set one if the port is exposed.
JUPYTER_TOKEN=
