{
    "version": "2.0.0",
    "tasks": [
        {
            // Points git at the repo's .githooks/ (Redmine notes, see
            // .githooks/redmine.py) every time the folder is opened. VS Code
            // asks once per user to allow automatic tasks.
            "label": "Install git hooks",
            "type": "shell",
            "command": "git config core.hooksPath .githooks",
            "runOptions": { "runOn": "folderOpen" },
            "presentation": { "reveal": "silent", "close": true }
        }
    ]
}
