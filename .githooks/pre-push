#!/bin/sh
# Installed by `git config core.hooksPath .githooks` — see .githooks/redmine.py.
# Never blocks the pre-push: any failure is only a warning.
PY=$(command -v python3 || command -v python)
if [ -z "$PY" ]; then
    echo "redmine: python3 not found, skipping pre-push hook" >&2
    exit 0
fi
"$PY" "$(dirname "$0")/redmine.py" pre-push "$@" || echo "redmine: pre-push hook failed (see above), continuing" >&2
exit 0
